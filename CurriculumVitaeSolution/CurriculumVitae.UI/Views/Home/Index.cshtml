                                <div class="rounded-2xl border border-red-500/20 bg-black/70 px-10 py-8 text-center shadow-2xl shadow-red-950/30 backdrop-blur-xl">

                                    <p class="font-mono text-[10px] uppercase tracking-[.3em] text-slate-600">
                                        observability
                                    </p>

                                    <p class="mt-3 text-3xl font-black text-red-400">
                                        Monitoring
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="p-8">


                            <div class="mb-4 flex items-center justify-between">

                                <h3 class="text-2xl font-bold text-white">
                                    Infrastructure Dashboards
                                </h3>

                                <a href="https://github.com/ThiWB?tab=repositories"
                                   target="_blank"
                                   class="text-slate-700 transition hover:text-red-400">
                                    ↗
                                </a>

                            </div>


                            <p class="leading-7 text-slate-500">

                                Infrastructure monitoring environment using
                                Zabbix, Grafana and Observium to track servers,
                                virtualization platforms and network devices.

                            </p>


                            <div class="mt-6 flex flex-wrap gap-2">

                                @foreach (var tech in new[]
                                {
                                "Zabbix",
                                "Grafana",
                                "Observium",
                                "VMware",
                                "Linux"
                                })
                                {
                                    <span class="rounded-md border border-red-500/10 bg-red-500/5 px-2.5 py-1 font-mono text-[10px] text-red-400">
                                        @tech
                                    </span>
                                }

                            </div>

                        </div>

                    </article>

                </div>

            </div>

        </section>


        <!-- =====================================================
             CERTIFICATIONS
        ====================================================== -->

        <section id="certifications">

            <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8">


                <div class="mb-16">

                    <p class="mb-4 font-mono text-xs tracking-[.3em] text-red-500">
                        04 / CERTIFICATIONS
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-white sm:text-6xl">

                        Always
                        <span class="text-red-500">
                            learning.
                        </span>

                    </h2>

                </div>


                <div class="grid gap-4 md:grid-cols-3">


                    @foreach (var cert in new[]
                    {
                    new {
                    Code = "AWS",
                    Title = "DevOps Journey with AWS",
                    Provider = "Digital Innovation One",
                    Hours = "69 hours"
                    },
                    new {
                    Code = "LNX",
                    Title = "CompTIA Linux+ Complete Course",
                    Provider = "Udemy",
                    Hours = "21 hours"
                    },
                    new {
                    Code = "VM",
                    Title = "Mastering VMware PowerCLI",
                    Provider = "Udemy",
                    Hours = "6 hours"
                    }
                    })
                    {
                        <article class="group rounded-2xl border border-white/5 bg-black/20 p-6 transition duration-300 hover:-translate-y-1 hover:border-red-500/30 hover:bg-red-500/[.025]">

                            <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-xl border border-red-500/10 bg-red-500/5 font-mono text-xs font-bold text-red-400">
                                @cert.Code
                            </div>

                            <h3 class="font-semibold text-white">
                                @cert.Title
                            </h3>

                            <p class="mt-2 text-sm text-slate-600">
                                @cert.Provider
                            </p>

                            <p class="mt-4 font-mono text-[10px] text-slate-700">
                                @cert.Hours
                            </p>

                        </article>
                    }

                </div>

            </div>

        </section>


        <!-- =====================================================
             CONTACT
        ====================================================== -->

        <section id="contact"
                 class="relative overflow-hidden border-t border-white/5">


            <div class="absolute left-1/2 top-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-red-600/10 blur-[130px]"></div>


            <div class="mx-auto max-w-4xl px-4 py-36 text-center sm:px-6 lg:px-8">


                <p class="mb-5 font-mono text-xs tracking-[.3em] text-red-500">
                    05 / CONTACT
                </p>


                <h2 class="text-5xl font-black leading-[.95] tracking-tight text-white sm:text-7xl">

                    Let's build

                    <br />

                    something

                    <span class="text-gradient">
                        great.
                    </span>

                </h2>


                <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-slate-500">

                    I'm open to new professional opportunities,
                    software development projects and interesting
                    technical conversations.

                </p>


                <div class="mt-10 flex flex-wrap justify-center gap-4">


                    <a href="mailto:thibalbinot@gmail.com"
                       class="rounded-xl bg-red-600 px-7 py-3.5 font-semibold text-white shadow-lg shadow-red-950/30 transition hover:-translate-y-0.5 hover:bg-red-500">

                        Email me
                    </a>


                    <a href="https://www.linkedin.com/in/thiago-wurster-balbinot-3b1932306/"
                       target="_blank"
                       class="rounded-xl border border-slate-800 bg-black/30 px-7 py-3.5 font-semibold text-slate-300 transition hover:border-red-500/30 hover:text-red-400">

                        LinkedIn
                    </a>


                    <a href="https://github.com/ThiWB"
                       target="_blank"
                       class="rounded-xl border border-slate-800 bg-black/30 px-7 py-3.5 font-semibold text-slate-300 transition hover:border-red-500/30 hover:text-red-400">

                        GitHub
                    </a>

                </div>

            </div>

        </section>

    </main>

    <footer class="border-t border-white/5">

        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-xs text-slate-700 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">

            <p class="font-mono">
                © @DateTime.Now.Year Thiago Wurster Balbinot
            </p>

            <p class="font-mono">
                Built with .NET · C# · Tailwind
            </p>

        </div>

    </footer>


</body>

</html>