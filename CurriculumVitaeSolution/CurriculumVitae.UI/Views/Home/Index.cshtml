<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {

                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui'],
                        mono: ['JetBrains Mono', 'monospace']
                    },

                    colors: {
                        blood: {
                            400: '#fb4b4b',
                            500: '#ef233c',
                            600: '#d90429',
                            700: '#b00020',
                            800: '#7f0018',
                            900: '#45000d'
                        }
                    },

                    boxShadow: {
                        'red-glow': '0 0 45px rgba(239,35,60,.18)',
                        'red-strong': '0 0 80px rgba(239,35,60,.25)'
                    },

                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-red': 'pulseRed 3s ease-in-out infinite',
                        'scan': 'scan 5s linear infinite',
                        'blink': 'blink 1s step-end infinite'
                    },

                    keyframes: {

                        float: {
                            '0%, 100%': {
                                transform: 'translateY(0px)'
                            },
                            '50%': {
                                transform: 'translateY(-12px)'
                            }
                        },

                        pulseRed: {
                            '0%, 100%': {
                                opacity: '.35',
                                transform: 'scale(1)'
                            },
                            '50%': {
                                opacity: '.65',
                                transform: 'scale(1.08)'
                            }
                        },

                        scan: {
                            '0%': {
                                transform: 'translateY(-100%)'
                            },
                            '100%': {
                                transform: 'translateY(100%)'
                            }
                        },

                        blink: {
                            '0%, 50%': {
                                opacity: '1'
                            },
                            '51%, 100%': {
                                opacity: '0'
                            }
                        }
                    }
                }
            }
        }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
                   BASE
                ========================================================= */

        html {
            scroll-behavior: smooth;
        }

        body {
            background: radial-gradient( circle at 15% 10%, rgba(239, 35, 60, .12), transparent 28% ), radial-gradient( circle at 85% 20%, rgba(127, 0, 24, .14), transparent 30% ), radial-gradient( circle at 50% 100%, rgba(239, 35, 60, .06), transparent 35% ), #050506;
            color: #e5e7eb;
        }

        ::selection {
            background: rgba(239, 35, 60, .35);
            color: white;
        }

        /* =========================================================
                   GRID
                ========================================================= */

        .grid-background {
            background-image: linear-gradient( rgba(255,255,255,.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.025) 1px, transparent 1px );
            background-size: 45px 45px;
        }

        /* =========================================================
                   TEXT
                ========================================================= */

        .text-gradient {
            background: linear-gradient( 90deg, #ffffff 0%, #fb4b4b 45%, #d90429 100% );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .text-gradient-red {
            background: linear-gradient( 90deg, #fb4b4b, #d90429 );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        /* =========================================================
                   GLASS
                ========================================================= */

        .glass {
            background: rgba(10, 10, 12, .72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,.07);
        }

        /* =========================================================
                   RED GLOW
                ========================================================= */

        .red-glow {
            box-shadow: 0 0 40px rgba(239,35,60,.12), inset 0 0 30px rgba(239,35,60,.025);
        }

        .red-line {
            background: linear-gradient( 90deg, transparent, #ef233c, transparent );
        }

        /* =========================================================
                   HERO IMAGE
                ========================================================= */

        .profile-frame {
            position: relative;
        }

            .profile-frame::before {
                content: "";
                position: absolute;
                inset: -1px;
                background: linear-gradient( 135deg, rgba(239,35,60,.8), transparent 35%, transparent 65%, rgba(127,0,24,.7) );
                border-radius: 1.5rem;
                z-index: -1;
                filter: blur(1px);
            }

            .profile-frame::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 180deg, transparent 55%, rgba(239,35,60,.12) );
                pointer-events: none;
                border-radius: 1.5rem;
            }

        /* =========================================================
                   TERMINAL
                ========================================================= */

        .terminal {
            background: #08090c;
            border: 1px solid rgba(239,35,60,.18);
            box-shadow: 0 25px 80px rgba(0,0,0,.55), 0 0 60px rgba(239,35,60,.08);
        }

        .terminal-line::before {
            content: ">";
            color: #ef233c;
            margin-right: .65rem;
        }

        /* =========================================================
                   CARD
                ========================================================= */

        .project-card {
            position: relative;
            overflow: hidden;
        }

            .project-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 1px;
                background: linear-gradient( 90deg, transparent, #ef233c, transparent );
                transition: .6s;
            }

            .project-card:hover::before {
                left: 100%;
            }

        /* =========================================================
                   SCROLLBAR
                ========================================================= */

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #050506;
        }

        ::-webkit-scrollbar-thumb {
            background: #3b0b11;
            border-radius: 999px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #d90429;
            }

    </style>
</head>


