@model CurriculumVitae.Core.Application.ViewModels.HomeViewModel;

@{
    ViewData["Title"] = "ThiagoWB — Full-Stack .NET";

    var skills = new[]
    {
        "C#",
        ".NET",
        "ASP.NET Core",
        "Java",
        "REST APIs",
        "SOAP",
        "PostgreSQL",
        "SQL Server",
        "Dapper",
        "Entity Framework",
        "JavaScript",
        "Tailwind CSS",
        "AWS",
        "Google Cloud Platform",
        "VMware ESXi/vCenter",
        "Hyper-V",
        "Linux",
        "Windows Server",
        "MikroTik",
        "Zabbix",
        "Grafana"
    };

    var certifications = new[]
    {
        new
        {
            Code = "AWS",
            Title = "DevOps Journey with AWS",
            Provider = "Digital Innovation One",
            Hours = "69 hours"
        },
        new
        {
            Code = "LNX",
            Title = "CompTIA Linux+ Complete Course",
            Provider = "Udemy",
            Hours = "21 hours"
        },
        new
        {
            Code = "VM",
            Title = "Mastering VMware PowerCLI",
            Provider = "Udemy",
            Hours = "6 hours"
        }
    };
}

<!DOCTYPE html>

<html lang="en" class="scroll-smooth">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Thiago Wurster Balbinot — Full-Stack Developer | .NET, C#, Java, APIs, databases and infrastructure" />

    <meta name="author"
          content="Thiago Wurster Balbinot" />

    <meta name="theme-color"
          content="#050506" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    fontFamily: {

                        sans: [
                            "Inter",
                            "ui-sans-serif",
                            "system-ui"
                        ],

                        mono: [
                            "JetBrains Mono",
                            "monospace"
                        ]

                    },

                    colors: {

                        blood: {

                            400: "#fb4b4b",
                            500: "#ef233c",
                            600: "#d90429",
                            700: "#b00020",
                            800: "#7f0018",
                            900: "#45000d"

                        }

                    },

                    boxShadow: {

                        "red-glow":
                            "0 0 45px rgba(239,35,60,.14)",

                        "red-strong":
                            "0 0 80px rgba(239,35,60,.20)"

                    },

                    animation: {

                        "float":
                            "float 6s ease-in-out infinite",

                        "pulse-red":
                            "pulseRed 4s ease-in-out infinite",

                        "blink":
                            "blink 1s step-end infinite"

                    },

                    keyframes: {

                        float: {

                            "0%, 100%": {
                                transform: "translateY(0)"
                            },

                            "50%": {
                                transform: "translateY(-10px)"
                            }

                        },

                        pulseRed: {

                            "0%, 100%": {
                                opacity: ".25",
                                transform: "scale(1)"
                            },

                            "50%": {
                                opacity: ".5",
                                transform: "scale(1.08)"
                            }

                        },

                        blink: {

                            "0%, 50%": {
                                opacity: "1"
                            },

                            "51%, 100%": {
                                opacity: "0"
                            }

                        }

                    }

                }

            }

        };

    </script>

    <style>

        :root {
            color-scheme: dark;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background: radial-gradient( circle at 15% 10%, rgba(239, 35, 60, .10), transparent 28% ), radial-gradient( circle at 85% 20%, rgba(127, 0, 24, .12), transparent 30% ), radial-gradient( circle at 50% 100%, rgba(239, 35, 60, .05), transparent 35% ), #050506;
            color: #e5e7eb;
            overflow-x: hidden;
        }


        ::selection {
            background: rgba(239, 35, 60, .35);
            color: white;
        }

        .grid-background {
            background-image: linear-gradient( rgba(255,255,255,.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.025) 1px, transparent 1px );
            background-size: 45px 45px;
        }

        .glass {
            background: rgba(8, 8, 10, .72);
            border: 1px solid rgba(255,255,255,.07);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .text-gradient {
            background: linear-gradient( 90deg, #ffffff 0%, #fb4b4b 45%, #d90429 100% );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .red-line {
            background: linear-gradient( 90deg, transparent, #ef233c, transparent );
        }

        #scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 2px;
            z-index: 9999;
            background: linear-gradient( 90deg, #fb4b4b, #d90429 );
            box-shadow: 0 0 15px rgba(239,35,60,.7);
        }

        .reveal {
            opacity: 0;
            transform: translateY(25px);
            transition: opacity .8s ease, transform .8s ease;
        }


            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .profile-image-wrapper {
            position: relative;
        }


            .profile-image-wrapper::before {
                content: "";
                position: absolute;
                inset: -24px;
                border-radius: 2rem;
                background: rgba(239,35,60,.10);
                filter: blur(50px);
                opacity: .7;
                transition: opacity .5s ease;
                z-index: -1;
            }


            .profile-image-wrapper:hover::before {
                opacity: 1;
            }


        .profile-image {
            transition: transform .7s cubic-bezier(.2,.8,.2,1), filter .7s ease;
        }


        .profile-image-wrapper:hover
        .profile-image {
            transform: scale(1.025);
        }

        .project-card {
            position: relative;
            overflow: hidden;
            transition: transform .4s ease, border-color .4s ease, box-shadow .4s ease;
        }


            .project-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 1px;
                background: linear-gradient( 90deg, transparent, #ef233c, transparent );
                transition: left .7s ease;
            }


            .project-card:hover::before {
                left: 100%;
            }


            .project-card:hover {
                transform: translateY(-7px);
                border-color: rgba(239,35,60,.30);
                box-shadow: 0 30px 80px rgba(0,0,0,.35), 0 0 50px rgba(239,35,60,.06);
            }

        .skill-tag {
            transition: transform .25s ease, border-color .25s ease, color .25s ease, background .25s ease;
        }


            .skill-tag:hover {
                transform: translateY(-3px);
            }

        .nav-link.active {
            color: #fb4b4b;
        }


        #cursor-glow {
            position: fixed;
            width: 300px;
            height: 300px;
            border-radius: 9999px;
            background: radial-gradient( circle, rgba(239,35,60,.07), transparent 70% );
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: -1;
            opacity: 0;
            transition: opacity .3s ease;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }


        ::-webkit-scrollbar-track {
            background: #050506;
        }


        ::-webkit-scrollbar-thumb {
            background: #3b0b11;
            border-radius: 999px;
        }


            ::-webkit-scrollbar-thumb:hover {
                background: #d90429;
            }


        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }


            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>

</head>


<body class="antialiased">

    <div id="scroll-progress"></div>

    <div id="cursor-glow"></div>

    <header class="fixed inset-x-0 top-0 z-50">

        <div class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-8">

            <nav class="glass rounded-2xl px-5 py-3 shadow-red-glow">

                <div class="flex items-center justify-between">

                    <a href="#home"
                       class="font-mono text-sm font-semibold tracking-tight text-white">

                        <span class="text-red-500">
                            &lt;
                        </span>

                        ThiagoWB

                        <span class="text-red-500">
                            /&gt;
                        </span>

                    </a>

                    <div class="hidden items-center gap-8 md:flex">

                        <a href="#about"
                           class="nav-link text-sm text-slate-500 transition hover:text-red-400">
                            About
                        </a>

                        <a href="#experience"
                           class="nav-link text-sm text-slate-500 transition hover:text-red-400">
                            Experience
                        </a>

                        <a href="#projects"
                           class="nav-link text-sm text-slate-500 transition hover:text-red-400">
                            Projects
                        </a>

                        <a href="#certifications"
                           class="nav-link text-sm text-slate-500 transition hover:text-red-400">
                            Certifications
                        </a>

                    </div>

                    <div class="flex items-center gap-3">


                        <a href="#contact"
                           class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-2 text-sm font-medium text-red-400 transition hover:border-red-400/60 hover:bg-red-500/20 hover:text-red-300 md:block">

                            Let's talk

                        </a>

                        <button id="menu-button"
                                type="button"
                                aria-label="Open navigation menu"
                                aria-expanded="false"
                                class="rounded-xl border border-white/10 p-2 text-slate-400 transition hover:border-red-500/30 hover:text-red-400 md:hidden">

                            <svg class="h-5 w-5"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="1.5"
                                      d="M4 6h16M4 12h16M4 18h16" />

                            </svg>

                        </button>

                    </div>

                </div>

                <div id="mobile-menu"
                     class="hidden">

                    <div class="mt-4 border-t border-white/5 pt-4">

                        <div class="flex flex-col gap-1">

                            <a href="#about"
                               class="mobile-link rounded-xl px-3 py-3 text-sm text-slate-500 transition hover:bg-red-500/5 hover:text-red-400">
                                About
                            </a>

                            <a href="#experience"
                               class="mobile-link rounded-xl px-3 py-3 text-sm text-slate-500 transition hover:bg-red-500/5 hover:text-red-400">
                                Experience
                            </a>

                            <a href="#projects"
                               class="mobile-link rounded-xl px-3 py-3 text-sm text-slate-500 transition hover:bg-red-500/5 hover:text-red-400">
                                Projects
                            </a>

                            <a href="#certifications"
                               class="mobile-link rounded-xl px-3 py-3 text-sm text-slate-500 transition hover:bg-red-500/5 hover:text-red-400">
                                Certifications
                            </a>

                            <a href="#contact"
                               class="mobile-link mt-2 rounded-xl bg-red-600 px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-red-500">
                                Let's talk
                            </a>

                        </div>

                    </div>

                </div>

            </nav>

        </div>

    </header>

    <main id="home">

        <section class="relative min-h-screen overflow-hidden">


            <div class="grid-background absolute inset-0 opacity-60"></div>


            <div class="absolute left-1/2 top-20 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-red-700/10 blur-[130px] animate-pulse-red"></div>


            <div class="absolute -left-32 top-1/3 h-72 w-72 rounded-full bg-red-900/10 blur-[100px]"></div>

            <div class="relative mx-auto flex min-h-screen max-w-7xl items-center px-4 pb-20 pt-36 sm:px-6 lg:px-8">

                <div class="grid w-full gap-10 lg:grid-cols-[1.2fr_.8fr] lg:items-center lg:gap-20">


                    <div class="reveal">


                        <h1 class="max-w-5xl text-5xl font-black leading-[.9] tracking-[-.05em] text-white sm:text-7xl lg:text-[6.4rem]">

                            &lt;Hello

                            <span class="text-slate-700">
                                friend.
                            </span>

                            <br />

                            <span class="text-slate-600">
                                I'm
                            </span>

                            <span class="text-gradient">
                                Thiago.&gt;
                            </span>

                        </h1>

                        <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-500 sm:text-xl">

                            Full-Stack Developer focused on

                            <span class="font-semibold text-slate-200">
                                .NET, C#, Java, APIs and databases
                            </span>

                            with a strong background in

                            <span class="font-semibold text-red-400">
                                infrastructure and virtualization.
                            </span>

                        </p>

                        <div class="mt-10 flex flex-wrap gap-4">

                            <a href="#projects"
                               class="group inline-flex items-center gap-3 rounded-xl bg-red-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-red-950/30 transition hover:-translate-y-1 hover:bg-red-500">

                                View my work

                            </a>


                            <a href="#contact"
                               class="inline-flex items-center gap-3 rounded-xl border border-slate-800 bg-black/30 px-6 py-3.5 font-semibold text-slate-300 transition hover:-translate-y-1 hover:border-red-500/40 hover:text-white">

                                Contact me

                            </a>

                        </div>

                    </div>


                    <div class="flex justify-center lg:justify-end">

                        <div class="profile-image-wrapper reveal group mt-2 lg:mt-0">

                            <div class="absolute -inset-6 rounded-[2rem] bg-red-600/10 blur-3xl transition duration-700 group-hover:bg-red-600/20"></div>

                            <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[#0a0a0c] shadow-2xl shadow-black/60">

                                <img src="@Url.Content("~/images/thiago.webp")"
                                     alt="Thiago Wurster Balbinot"
                                     loading="eager"
                                     class="profile-image relative z-10 aspect-[4/5] w-full max-w-[280px] sm:max-w-[340px] lg:max-w-[380px] object-cover grayscale" />



                                <div class="absolute inset-x-0 bottom-0 z-20 h-32 bg-gradient-to-t from-black/70 to-transparent"></div>

                            </div>


                            <div class="pointer-events-none absolute -right-3 -top-3 h-20 w-20 rounded-tr-[2rem] border-r border-t border-red-500/40 transition duration-500 group-hover:-right-4 group-hover:-top-4"></div>

                            <div class="pointer-events-none absolute -bottom-3 -left-3 h-20 w-20 rounded-bl-[2rem] border-b border-l border-red-500/40 transition duration-500 group-hover:-bottom-4 group-hover:-left-4"></div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 md:flex">

                <span class="font-mono text-[9px] uppercase tracking-[.4em] text-slate-700">
                    Scroll
                </span>

                <div class="h-10 w-px bg-gradient-to-b from-red-500 to-transparent"></div>

            </div>

        </section>


        <section id="about"
                 class="border-y border-white/5 bg-[#080809]">

            <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8">

                <div class="grid gap-16 lg:grid-cols-[.65fr_1.35fr]">


                    <div class="reveal">

                        <p class="mb-4 font-mono text-xs tracking-[.3em] text-red-500">
                            01 / ABOUT
                        </p>

                        <h2 class="text-4xl font-black tracking-tight text-white sm:text-6xl">

                            About
                            <span class="text-red-500">
                                me.
                            </span>

                        </h2>

                    </div>


                    <div class="reveal">

                        <p class="text-lg leading-8 text-slate-400">

                            I am a software developer and infrastructure enthusiast
                            based in Videira, Santa Catarina, Brazil.

                            Currently pursuing my B.S. in Computer Science at
                            <span class="font-medium text-white">
                                UNOESC
                            </span>,
                            with expected graduation in 2027.

                        </p>


                        <p class="mt-6 text-lg leading-8 text-slate-400">

                            My work combines software engineering with infrastructure,
                            allowing me to understand systems from the application layer
                            all the way down to servers, networks and virtualization platforms.

                        </p>


                        <div class="mt-12">

                            <p class="mb-5 font-mono text-[10px] uppercase tracking-[.3em] text-slate-600">
                                Technologies
                            </p>


                            <div class="flex flex-wrap gap-2 mb-10">

                                @foreach (var skill in skills)
                                {
                                    <span class="skill-tag cursor-default rounded-lg border border-white/5 bg-black/30 px-3 py-2 font-mono text-xs text-slate-500 hover:border-red-500/30 hover:bg-red-500/5 hover:text-red-400">
                                        @skill
                                    </span>
                                }

                            </div>

                            <a asp-controller="Home" asp-action="About"
                               class="group inline-flex items-center gap-3 rounded-xl bg-red-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-red-950/30 transition hover:-translate-y-1 hover:bg-red-500">

                                Read More

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <section id="experience">

            <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8">


                <div class="mb-16 reveal">

                    <p class="mb-4 font-mono text-xs tracking-[.3em] text-red-500">
                        02 / EXPERIENCE
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-white sm:text-6xl">

                        Where I've

                        <span class="text-red-500">
                            worked.
                        </span>

                    </h2>

                </div>


                <div class="relative ml-3 border-l border-red-950">

                    @foreach (var experience in Model.Experiences)
                    {
                        <article class="relative pb-16 pl-10">

                            <span class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full bg-slate-700 ring-4 ring-[#05070b]"></span>

                            <div class="grid gap-5 lg:grid-cols-[220px_1fr]">

                                <div>
                                    <p class="font-mono text-xs text-slate-500">
                                        @experience.EntryDate.ToString("MMM yyyy")
                                        —
                                        @(experience.EndDate == null
                                                                            ? "Present"
                                                                            : experience.EndDate?.ToString("MMM yyyy"))
                                </p>
                            </div>

                                <div>

                                    <h3 class="text-xl font-semibold text-white">
                                        @experience.CompanyName
                                    </h3>

                                    <p class="mt-1 text-slate-500">
                                        @experience.Subtitle
                                    </p>

                                    <p class="mt-5 max-w-3xl leading-7 text-slate-400">
                                        @experience.Description
                                    </p>

                                </div>

                            </div>

                        </article>
                                        }


                </div>

            </div>

        </section>


        <section id="projects"
                 class="border-y border-white/5 bg-[#080809]">

            <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8">


                <div class="mb-16 flex flex-col justify-between gap-6 sm:flex-row sm:items-end reveal">

                    <div>

                        <p class="mb-4 font-mono text-xs tracking-[.3em] text-red-500">
                            03 / PROJECTS
                        </p>

                        <h2 class="text-4xl font-black tracking-tight text-white sm:text-6xl">

                            Things I've

                            <span class="text-red-500">
                                built.
                            </span>

                        </h2>

                    </div>

                </div>


                <div class="grid gap-6 lg:grid-cols-2">
                    @foreach (var project in Model.Projects)
                    {
                        <div class="project-card reveal block cursor-pointer overflow-hidden rounded-2xl border border-white/5 bg-black/30 grayscale transition-all duration-500 hover:grayscale-0"
                             onclick="openProjectModal(
                                    '@project.ProjectName',
                                    '@project.Subtitle',
                                    '@Url.Content(project.Image)',
                                    '@project.Id',
                                    '@project.Description',
                                    '@project.Link'
                                 )">

                            <div class="relative h-64 overflow-hidden bg-gradient-to-br from-red-950/40 via-black to-[#13070a]">

                                <div class="grid-background absolute inset-0 opacity-50"></div>

                                <div class="absolute inset-0 flex items-center justify-center p-4">

                                    <div class="h-full w-full rounded-2xl border border-red-500/20 bg-black/70 text-center shadow-2xl shadow-red-950/30 backdrop-blur-xl">

                                        <img class="h-full w-full object-contain"
                                             src="@Url.Content(project.Image)"
                                             alt="@project.ProjectName" />

                                    </div>

                                </div>

                            </div>

                            <div class="p-8">

                                <h3 class="mb-2 text-2xl font-bold text-white">
                                    @project.ProjectName
                                </h3>

                                <p class="leading-7 text-slate-500">
                                    @project.Subtitle
                                </p>

                            </div>

                        </div>
                    }

                    <div id="projectModal"
                         class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
                         onclick="closeProjectModal(event)">

                        <div class="relative w-full max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-[#0a0a0a] shadow-2xl shadow-red-950/30"
                             onclick="event.stopPropagation()">

                            <button type="button"
                                    onclick="closeProjectModal()"
                                    class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/70 text-xl text-white transition hover:bg-red-500">
                                &times;
                            </button>

                            <div class="flex h-72 items-center justify-center overflow-hidden bg-black p-4">

                                <img id="modalProjectImage"
                                     src=""
                                     alt=""
                                     class="h-full w-full object-contain" />

                            </div>

                            <div class="p-8">

                                <p class="mb-3 font-mono text-xs tracking-[.3em] text-red-500">
                                    PROJECT
                                </p>

                                <h2 id="modalProjectTitle"
                                    class="mb-1 text-3xl font-black text-white">
                                </h2>

                                <p id="modalProjectSubtitle"
                                   class="mb-4 leading-7 text-slate-400">
                                </p>

                                <p id="modalProjectDescription"
                                   class="mb-8 leading-7 text-slate-500">
                                </p>

                                <a id="modalProjectDetails"
                                   href=""
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="inline-flex rounded-lg bg-red-500 px-6 py-3 font-semibold text-white transition hover:bg-red-400">
                                    Link
                                </a>

                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </section>


        <section id="certifications">

            <div class="mx-auto max-w-7xl px-4 py-28 sm:px-6 lg:px-8">


                <div class="mb-16 reveal">

                    <p class="mb-4 font-mono text-xs tracking-[.3em] text-red-500">
                        04 / CERTIFICATIONS
                    </p>

                    <h2 class="text-4xl font-black tracking-tight text-white sm:text-6xl">

                        Always

                        <span class="text-red-500">
                            learning.
                        </span>

                    </h2>

                </div>


                <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">

                    @foreach (var cert in Model.Certifications)
                    {
